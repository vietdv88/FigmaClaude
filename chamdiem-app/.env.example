# ── Bắt buộc ──
# Địa chỉ người dùng truy cập (dùng cho link mời + cookie bảo mật khi là https)
APP_URL=https://chamdiem.congty.vn
# Link trong email (mời / đặt mật khẩu) tự lấy theo địa chỉ đang mở app nếu địa chỉ đó hợp lệ (APP_URL, localhost, APP_HOSTS);
# thêm các địa chỉ khác của cùng máy chủ (VD IP) vào APP_HOSTS, cách nhau dấu phẩy.
# APP_HOSTS=10.1.39.11
# OAuth Client ID (Web) tạo trong Google Cloud Console — xem DEPLOY.md
# ── Đăng nhập bằng MISA ID (OpenID Connect) — đội MISA ID cấp; có cấu hình thì trang đăng nhập hiện nút "Đăng nhập bằng MISA ID"
MISA_ID_CLIENT_ID=
MISA_ID_CLIENT_SECRET=
# Địa chỉ quay về (phải đăng ký với MISA ID). Mặc định: APP_URL + /api/auth/misa/callback
# MISA_ID_REDIRECT_URI=https://pdpoint.misa.vn/api/auth/misa/callback
# Claim nhận diện nhân viên (lấy cái đầu tiên có giá trị): email,preferred_username
# MISA_ID_USER_CLAIM=email,preferred_username
# MISA_ID_SCOPES=openid profile

# ── Đăng nhập bằng Google (tùy chọn — để trống nếu chỉ dùng MISA ID)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxx.apps.googleusercontent.com
# Chuỗi ngẫu nhiên dài để ký phiên đăng nhập:  openssl rand -hex 32
SESSION_SECRET=thay-bang-chuoi-ngau-nhien-dai
# Gmail Quản trị đầu tiên (cách nhau dấu phẩy) — đăng nhập lần đầu tự thành Quản trị
# Quản trị đầu tiên: Gmail hoặc tài khoản MISA ID (cách nhau dấu phẩy)
ADMIN_EMAILS=ban@gmail.com

# ── Tùy chọn ──
# Cổng trên máy host
HOST_PORT=8080
# Dữ liệu ban đầu khi DB trống: sample (dữ liệu mẫu hiện có) | empty
SEED=sample
# Gửi email mời qua SMTP (bỏ trống = app hiện link mời để Quản trị tự gửi)
# Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS = Mật khẩu ứng dụng 16 ký tự
#   (myaccount.google.com/apppasswords — cần bật Xác minh 2 bước), KHÔNG phải mật khẩu đăng nhập.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=designer@software.misa.com.vn
SMTP_PASS=
SMTP_FROM="MISA PD Point <designer@software.misa.com.vn>"

# Chế độ dùng thử: không cần đăng nhập, ai mở app cũng vào được và chuyển sang bất kỳ người dùng nào (kể cả Quản trị).
# CHỈ bật trong mạng nội bộ để thử — tắt (xóa dòng / để trống) khi dùng thật.
# OPEN_DEMO=1

# Số tháng giữ dữ liệu công việc (mặc định 24 = 2 năm gần nhất; 0 = không tự dọn).
# Công việc cũ hơn được nén lưu vào /data/archive/ rồi xóa khỏi app; bản chốt điểm tháng vẫn giữ.
# RETENTION_MONTHS=24

# HTTPS: có chứng chỉ thì app mở thêm cổng HTTPS_PORT (mặc định 443).
# HTTPS_REDIRECT=1 → cổng PORT chỉ chuyển hướng sang https (bật khi chứng chỉ đã được trình duyệt tin cậy).
# HTTPS_CERT=/opt/pdpoint/tls/cert.pem
# HTTPS_KEY=/opt/pdpoint/tls/key.pem
# HTTPS_PORT=443
# HTTPS_REDIRECT=0
